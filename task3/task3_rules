@prefix : <http://www.semanticweb.org/быковаанна/ontologies/2025/9/smart-home-ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/быковаанна/ontologies/2025/9/smart-home-ontology/> .

#################################################################
#    Rules
#################################################################

:Устройство_var rdf:type <http://www.w3.org/2003/11/swrl#Variable> .
:Мощность_var rdf:type <http://www.w3.org/2003/11/swrl#Variable> .
:Часы_var rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Правило классификации энерго-неэффективных устройств: если устройство имеет высокую мощность (>500 Вт) И работает много часов в день (>4 часов), то оно классифицируется как энерго-неэффективное" ;
   rdfs:label "КлассификацияЭнергоНеэффективныхУстройств" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ 
     rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
     rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                 <http://www.w3.org/2003/11/swrl#classPredicate> :Устройство ;
                 <http://www.w3.org/2003/11/swrl#argument1> :Устройство_var
               ] ;
     rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                            <http://www.w3.org/2003/11/swrl#propertyPredicate> :мощность_вт ;
                            <http://www.w3.org/2003/11/swrl#argument1> :Устройство_var ;
                            <http://www.w3.org/2003/11/swrl#argument2> :Мощность_var
                          ] ;
                rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :часы_работы_в_день ;
                                       <http://www.w3.org/2003/11/swrl#argument1> :Устройство_var ;
                                       <http://www.w3.org/2003/11/swrl#argument2> :Часы_var
                                     ] ;
                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#BuiltinAtom> ;
                                                  <http://www.w3.org/2003/11/swrl#builtin> <http://www.w3.org/2003/11/swrlb#greaterThan> ;
                                                  <http://www.w3.org/2003/11/swrl#arguments> ( :Мощность_var "500"^^xsd:integer )
                                                ] ;
                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#BuiltinAtom> ;
                                                             <http://www.w3.org/2003/11/swrl#builtin> <http://www.w3.org/2003/11/swrlb#greaterThan> ;
                                                             <http://www.w3.org/2003/11/swrl#arguments> ( :Часы_var "4"^^xsd:decimal )
                                                           ] ;
                                                 rdf:rest rdf:nil
                                               ]
                                    ]
                         ]
              ]
   ] ;
   <http://www.w3.org/2003/11/swrl#head> [ 
     rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
     rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                 <http://www.w3.org/2003/11/swrl#classPredicate> :ЭнергоНеэффективноеУстройство ;
                 <http://www.w3.org/2003/11/swrl#argument1> :Устройство_var
               ] ;
     rdf:rest rdf:nil
   ]
 ] .
